{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:default",
    "deep-link:default",
    "opener:default",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }, { "url": "http://*" }, { "url": "https://*:*" }, { "url": "http://*:*" }]
    }
  ]
}
