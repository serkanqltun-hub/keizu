{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Keizu",
  "version": "0.1.0",
  "identifier": "dev.keizu.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Keizu",
        "width": 1280,
        "height": 820,
        "minWidth": 720,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "keizu"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY2RjVCRjlERTA1NDdGMUYKUldRZmYxVGduYi8xWm16eFhwZDlyY2FXV0tNTHRoSVJsR09zYlFVTU1pNGZ2bHVjWFFkOEVhQk8K",
      "endpoints": [
        "https://github.com/serkanqltun-hub/keizu/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "app",
      "dmg",
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Productivity",
    "shortDescription": "Open-source mind mapping",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "keizu"
        ],
        "name": "Keizu",
        "description": "Keizu zihin haritası",
        "role": "Editor",
        "mimeType": "application/x-keizu"
      }
    ]
  }
}
